# ============================================================================
# USDQS (USD Quantum Stable) 풀스택 플랫폼 환경변수 설정 템플릿 (.env.example)
# 실제 운영 시 본 파일을 '.env'로 복사하여 민감 정보를 설정하십시오.
# 절대 API 키나 시크릿 키를 소스 코드에 하드코딩하지 마십시오.
# ============================================================================

# 1. 백엔드 코어 API 서버 설정
PORT=4000
NODE_ENV=development

# 2. JWT 인증 및 PBKDF2 보안 해싱 설정
JWT_ACCESS_SECRET=replace_with_32_byte_quantum_safe_access_secret_key
JWT_REFRESH_SECRET=replace_with_32_byte_quantum_safe_refresh_secret_key
JWT_EXPIRES_IN=1h
PBKDF2_ITERATIONS=150000
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=30

# 3. 데이터베이스 (PostgreSQL / Supabase) 연동 설정
DATABASE_URL=postgresql://postgres:password@localhost:5432/usdqs_production?schema=public
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# 4. 블록체인 & Web3 & PQC (NIST FIPS 203/204) 설정
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
USDQS_ERC20_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7
ERC4337_BUNDLER_URL=https://bundler.usdqs.io/v1/rpc
CHAINLINK_POR_FEED_ADDRESS=0x982a991c74b1a0c0e8f4b2d8a11234567890abcd

